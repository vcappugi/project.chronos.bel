<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/accent_cyan"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_vault_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vault_status_secure"
        android:textColor="@color/accent_emerald"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp" />

    <!-- Timer Display Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/bg_secondary"
        android:padding="28dp">

        <TextView
            android:id="@+id/tv_timer_digits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/text_primary"
            android:textSize="44sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start"
                android:backgroundTint="@color/accent_emerald" />

            <Button
                android:id="@+id/btn_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_pause"
                android:layout_marginStart="10dp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_stop"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/accent_indigo" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
